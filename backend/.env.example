# ---------------------------------------------------------------------------
# BarathSeva AI — backend configuration
# Copy to `.env` and edit. Every value has a working local default, so the
# prototype runs with this file absent.
# ---------------------------------------------------------------------------

# --- application ---
BARATHSEVA_ENVIRONMENT=development
BARATHSEVA_CITY=Bengaluru
BARATHSEVA_CORS_ORIGINS=http://localhost:3000

# --- infrastructure (matches docker-compose.yml port mappings) ---
BARATHSEVA_DATABASE_URL=postgresql+psycopg2://barathseva:barathseva@localhost:55432/barathseva
BARATHSEVA_REDIS_URL=redis://localhost:56379/0
BARATHSEVA_MEDIA_ROOT=media

# --- secrets ---
# Signs capture tokens. MUST be replaced outside local development.
BARATHSEVA_SECRET_KEY=dev-insecure-secret-change-me

# --- AI provider ---
# stub = deterministic rule engine, runs with no API key and no network.
# Set to `openai`, `gemini` or `nvidia` with the matching key for model-backed
# reasoning.
#
# RECOMMENDED LIVE TOPOLOGY (measured 2026-10-01, not guessed): `gemini` as the
# primary with `nvidia` as the rate-limit secondary. Kimi K3 on NIM took 205.9s
# for a trivial 31-token text completion -- far past the 20s default timeout --
# so it cannot serve the synchronous intake path, while Gemini 3 Flash answered
# the same multimodal verify prompt in 16s. The request shape for both is
# correct and tested; the difference is purely latency.
BARATHSEVA_AI_PROVIDER=stub
# BARATHSEVA_OPENAI_API_KEY=sk-...
# BARATHSEVA_OPENAI_MODEL=gpt-4o-mini
# BARATHSEVA_GEMINI_API_KEY=...
# BARATHSEVA_GEMINI_MODEL=gemini-3-flash-preview
# NOTE: gemini-2.0-flash and gemini-2.5-flash now 404 with "no longer
# available to new users"; gemini-3.8-flash and gemini-flash-latest returned
# 503 under load. Check ListModels if this one stops resolving.
# BARATHSEVA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- NVIDIA NIM (Kimi K3) ---
# BARATHSEVA_NVIDIA_API_KEY=nvapi-...
# BARATHSEVA_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# BARATHSEVA_NVIDIA_MODEL=moonshotai/kimi-k3

# --- AI fallback policy ---
# Provider used ONLY when the primary reports a rate limit. Empty disables.
BARATHSEVA_AI_RATE_LIMIT_FALLBACK=gemini
# After a rate limit, skip the primary for this long and use the fallback.
BARATHSEVA_AI_RATE_LIMIT_COOLDOWN_SECONDS=120
# Connect+read timeout for every provider HTTP call.
BARATHSEVA_AI_REQUEST_TIMEOUT_SECONDS=20.0
# Largest image sent to a vision model. Larger images are downscaled.
BARATHSEVA_AI_MAX_IMAGE_BYTES=3000000

# --- mock surfaces ---
# Mock government endpoints are force-disabled in production regardless of
# this flag (see Settings.mock_apis_enabled).
BARATHSEVA_ENABLE_MOCK_APIS=true
BARATHSEVA_GOV_GATEWAY_MODE=inprocess
# BARATHSEVA_MOCK_GOV_BASE_URL=http://localhost:8000/mock/gov
# BARATHSEVA_GOV_CALLBACK_SECRET=some-shared-secret

# --- evidence policy (Section 5 of the README) ---
BARATHSEVA_CAPTURE_TOKEN_TTL_SECONDS=300
BARATHSEVA_EXIF_TIME_TOLERANCE_SECONDS=900
BARATHSEVA_CITY_UTC_OFFSET_MINUTES=330
BARATHSEVA_GPS_ACCURACY_MAX_METERS=100
BARATHSEVA_EXIF_GPS_TOLERANCE_METERS=250
BARATHSEVA_PHASH_DUPLICATE_DISTANCE=10
BARATHSEVA_PHASH_HARD_FAIL_DISTANCE=2
BARATHSEVA_REPORTER_MAX_SPEED_KMH=120

# --- authenticity score bands ---
BARATHSEVA_AUTHENTICITY_AUTO_ACCEPT=0.70
BARATHSEVA_AUTHENTICITY_REVIEW_FLOOR=0.40

# --- geo clustering ---
BARATHSEVA_CLUSTER_RADIUS_METERS=150
BARATHSEVA_CLUSTER_WINDOW_HOURS=72
BARATHSEVA_HOTSPOT_MIN_COMPLAINTS=4

# --- social amplification policy ---
BARATHSEVA_SOCIAL_MIN_CLUSTER_SIZE=4
BARATHSEVA_SOCIAL_PRIORITIES=P1,P2

# --- authentication ---
# Signs session JWTs. Falls back to BARATHSEVA_SECRET_KEY when unset; set both
# explicitly outside local development so they can rotate independently.
# BARATHSEVA_JWT_SECRET=change-me-too
BARATHSEVA_ACCESS_TOKEN_TTL_MINUTES=720
BARATHSEVA_PASSWORD_MIN_LENGTH=8
# bcrypt work factor. 12 is the production default; the test suite uses 4.
BARATHSEVA_BCRYPT_ROUNDS=12
BARATHSEVA_LOGIN_MAX_ATTEMPTS=8
BARATHSEVA_LOGIN_ATTEMPT_WINDOW_SECONDS=900
BARATHSEVA_ALLOW_CITIZEN_SELF_REGISTRATION=true

# Shared password for the seeded demo accounts. Demo accounts are skipped
# entirely when BARATHSEVA_ENVIRONMENT is production.
BARATHSEVA_DEMO_PASSWORD=BarathSeva#2026

# --- geocoding (OpenStreetMap Nominatim, proxied through the backend) ---
# Identify your deployment: Nominatim's usage policy requires a real contact.
BARATHSEVA_NOMINATIM_USER_AGENT=BarathSeva-AI-Prototype/0.1 (civic complaints)
BARATHSEVA_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
BARATHSEVA_GEOCODE_CACHE_TTL_SECONDS=86400
BARATHSEVA_GEOCODE_RATE_LIMIT_PER_MINUTE=30

# --- legacy admin key ---
# Superseded by role-based auth on /api/admin/*. Retained only so an existing
# deployment does not break on an unknown variable.
BARATHSEVA_ADMIN_API_KEY=dev-admin-key
BARATHSEVA_REQUIRE_ADMIN_KEY=false

# --- telegram (optional) ---
# BARATHSEVA_TELEGRAM_BOT_TOKEN=123456:ABC...
# BARATHSEVA_TELEGRAM_WEBHOOK_SECRET=some-shared-secret
